const CATS = Object.keys(RAW);
const $=id=>document.getElementById(id);
const store={get(k,f){try{const v=localStorage.getItem(k);return v?JSON.parse(v):f}catch(e){return f}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}};

let active=new Set(store.get("cats60",CATS).filter(c=>CATS.includes(c))); if(!active.size) active=new Set(CATS);
let seen=new Set(store.get("seen60",[]));
let mode=store.get("mode60","prep"); if(mode!=="quick"&&mode!=="prep") mode="quick";
let speakSec=store.get("sec60",60);
let current=null, timerId=null, wake=null;
const C=282.74;

const fmt=s=>Math.floor(s/60)+":"+String(s%60).padStart(2,"0");
const talkSec=()=>mode==="prep"?60:speakSec;
function dial(sec,total){ $("num").textContent=total===3?String(sec):fmt(sec); $("arc").style.strokeDashoffset=C*(sec/total); }
function resetDial(){ $("arc").style.transition="none"; dial(mode==="prep"?600:talkSec(), 1); $("arc").style.strokeDashoffset=C; $("num").textContent=fmt(mode==="prep"?600:talkSec()); void $("arc").offsetWidth; $("arc").style.transition=""; $("dial").classList.remove("pulse"); }
function buttons(a,fa,b,fb){ $("b1").textContent=a; $("b1").onclick=fa; $("b2").textContent=b; $("b2").onclick=fb; }

async function keepAwake(on){
  try{ if(on&&"wakeLock" in navigator&&!wake){ wake=await navigator.wakeLock.request("screen"); wake.addEventListener("release",()=>wake=null); }
       if(!on&&wake){ await wake.release(); wake=null; } }catch(e){}
}

let actx=null;
function audio(){ try{ actx=actx||new (window.AudioContext||window.webkitAudioContext)(); if(actx.state==="suspended") actx.resume(); }catch(e){} }
function tick(){
  if(!actx) return;
  try{
    const t=actx.currentTime, o=actx.createOscillator(), g=actx.createGain();
    o.type="triangle"; o.frequency.setValueAtTime(2200,t);
    g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(0.08,t+0.002); g.gain.exponentialRampToValueAtTime(0.0001,t+0.03);
    o.connect(g); g.connect(actx.destination); o.start(t); o.stop(t+0.04);
  }catch(e){}
}
function pick(){
  let pool=QUESTIONS.filter(q=>active.has(q.category));
  if(mode!=="prep"){ pool=pool.filter(q=>q.category!=="Kavramlar"); if(!pool.length) pool=QUESTIONS.filter(q=>q.category!=="Kavramlar"); }
  if(mode==="prep"){ const why=pool.filter(q=>KW[q.id]); if(why.length) pool=why; }
  const others=pool.filter(q=>!current||q.category!==current.category);
  if(active.size>1&&others.length) pool=others;
  let fresh=pool.filter(q=>!seen.has(q.id));
  if(!fresh.length){ pool.forEach(q=>seen.delete(q.id)); fresh=pool.filter(q=>!current||q.id!==current.id); }
  return fresh[Math.floor(Math.random()*fresh.length)];
}
function pill(){ if(current) $("cat").textContent=current.category; }
function idle(){ stop(); pill(); showKw(); $("follow").classList.add("hidden"); resetDial(); buttons("Değiştir",spin,"Başla",start); }
function spin(){
  idle(); $("kw").classList.add("hidden");
  const next=pick();
  const done=()=>{ $("b1").disabled=false; $("b2").disabled=false; $("q").classList.remove("flick"); $("q").textContent=next.question; current=next; pill(); showKw(); seen.add(next.id); store.set("seen60",[...seen]); };
  if(!current||matchMedia("(prefers-reduced-motion: reduce)").matches){ done(); return; }
  audio(); let n=0; $("b1").disabled=true; $("b2").disabled=true; $("q").classList.add("flick");
  const iv=setInterval(()=>{ const r=QUESTIONS[Math.floor(Math.random()*QUESTIONS.length)]; $("q").textContent=r.question; tick(); if(++n>7){clearInterval(iv);done();} },60);
}
function run(total,onEnd){
  clearInterval(timerId);
  let left=total; $("arc").style.transition="none"; dial(left,total); void $("arc").offsetWidth; $("arc").style.transition="";
  timerId=setInterval(()=>{ left--; dial(Math.max(left,0),total); if(left<=0){ clearInterval(timerId); onEnd(); } },1000);
}
function stop(){ clearInterval(timerId); keepAwake(false); }
function start(){
  keepAwake(true);
  if(mode==="prep"){ showKw(); buttons("Değiştir",spin,"Konuş",talk); run(600,()=>{ $("num").textContent="0:00"; }); }
  else talk();
}
function showKw(){ const k=current&&mode==="prep"&&KW[current.id]; $("kw").textContent=k||""; $("kw").classList.toggle("hidden",!k); }
function talk(){
  $("kw").classList.add("hidden");
  clearInterval(timerId); keepAwake(true);
  buttons("Tıkandım",()=>{ $("follow").textContent=current.followUp; $("follow").classList.remove("hidden"); },"Bitir",end);
  $("dial").classList.add("pulse");
  run(3,()=>{ $("dial").classList.remove("pulse"); run(talkSec(),end); });
}
function end(){ stop(); $("dial").classList.remove("pulse"); $("num").textContent="0:00"; $("follow").classList.add("hidden"); $("arc").style.strokeDashoffset=C; buttons("Tekrar",()=>{idle();start();},"Sıradaki",spin); }

function renderSettings(){
  $("modes").querySelectorAll("button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.m===mode));
  $("durations").classList.toggle("hidden",mode==="prep");
  $("durations").querySelectorAll("button").forEach(b=>b.setAttribute("aria-pressed",+b.dataset.s===speakSec));
  $("chips").innerHTML="";
  CATS.forEach(c=>{ const b=document.createElement("button"); b.className="chip"; b.textContent=c; b.setAttribute("aria-pressed",active.has(c));
    b.onclick=()=>{ if(active.has(c)&&active.size===1) return; active.has(c)?active.delete(c):active.add(c); store.set("cats60",[...active]); renderSettings(); };
    $("chips").appendChild(b); });
}
$("modes").querySelectorAll("button").forEach(b=>b.onclick=()=>{ mode=b.dataset.m; store.set("mode60",mode); renderSettings(); });
$("durations").querySelectorAll("button").forEach(b=>b.onclick=()=>{ speakSec=+b.dataset.s; store.set("sec60",speakSec); renderSettings(); });
