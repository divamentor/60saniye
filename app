<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>60 Saniye</title>
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="60 Saniye">
<meta name="application-name" content="60 Saniye">
<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<link rel="icon" type="image/png" href="data:image/png;base64,">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#FFFFFF; --ink:#000000; --muted:#8C8C8C; --ring:#E8E8E8; --accent:#000000; --btn:#000000; --btn-ink:#FFFFFF; --btn2:#F2F2F2; --sheet:#FFFFFF;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#000000;--ink:#FFFFFF;--muted:#8C8C8C;--ring:#262626;--accent:#FFFFFF;--btn:#FFFFFF;--btn-ink:#000000;--btn2:#1A1A1A;--sheet:#0A0A0A}
}
:root[data-theme="dark"]{--bg:#000000;--ink:#FFFFFF;--muted:#8C8C8C;--ring:#262626;--accent:#FFFFFF;--btn:#FFFFFF;--btn-ink:#000000;--btn2:#1A1A1A;--sheet:#0A0A0A}
*,*::before,*::after{box-sizing:inherit}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--ink);font-family:"Instrument Sans",system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-tap-highlight-color:transparent;overflow:hidden;user-select:none}
button{font:inherit;color:inherit;cursor:pointer;border:none;background:none}
button:focus-visible{outline:3px solid var(--accent);outline-offset:3px}

.app{height:100%;display:grid;grid-template-rows:auto 1fr auto;max-width:1180px;margin:0 auto;padding:clamp(16px,3vw,36px) clamp(20px,5vw,64px)}
.top{display:flex;justify-content:space-between;align-items:center;min-height:48px}
.pill{border:1.5px solid var(--ink);color:var(--ink);font-weight:600;padding:7px 16px;border-radius:999px;font-size:clamp(.9rem,1.6vw,1.05rem)}
.icon{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;color:var(--muted)}
.icon:hover{color:var(--ink)}
.icon svg{width:26px;height:26px}

.stage{display:grid;align-content:center;gap:clamp(28px,5vh,56px);min-height:0}
.q{font-size:clamp(2.1rem,5.6vw,4.4rem);line-height:1.1;font-weight:600;letter-spacing:-.035em;margin:0;text-wrap:balance}
.q.flick{opacity:.3}
.follow{margin:clamp(16px,3vh,28px) 0 0;font-size:clamp(1.2rem,2.6vw,1.9rem);line-height:1.25;font-weight:400;color:var(--muted);text-wrap:balance}

.dial{position:relative;width:clamp(150px,22vw,240px);aspect-ratio:1;justify-self:start}
.dial svg{width:100%;height:100%;transform:rotate(-90deg)}
.dial circle{fill:none;stroke-width:3}
.dial .bg{stroke:var(--ring)}
.dial .fg{stroke:var(--ink);stroke-linecap:butt;transition:stroke-dashoffset 1s linear}
.dial .num{position:absolute;inset:0;display:grid;place-items:center;font-variant-numeric:tabular-nums;font-weight:500;font-size:clamp(2.2rem,5vw,3.6rem);letter-spacing:-.02em}

@media (prefers-reduced-motion:reduce){.dial .fg{transition:none}}

.controls{display:flex;gap:14px;padding-top:16px}
.btn{flex:1;height:clamp(60px,9vh,76px);border-radius:14px;font-weight:600;font-size:clamp(1.05rem,2vw,1.3rem);background:var(--btn);color:var(--btn-ink)}
.btn.alt{background:var(--btn2);color:var(--ink)}

@media (min-width:880px) and (orientation:landscape){
  .stage{grid-template-columns:1fr auto;align-items:center;column-gap:clamp(40px,6vw,96px)}
  .dial{justify-self:end}
  .controls{max-width:560px;margin-left:auto;width:100%}
}

.scrim{position:fixed;inset:0;background:rgba(0,0,0,.5);display:grid;place-items:end center;z-index:5}
.sheet{background:var(--sheet);border:1px solid var(--ring);width:min(640px,100%);border-radius:28px 28px 0 0;padding:28px 28px calc(28px + env(safe-area-inset-bottom,0px));display:grid;gap:22px}
@media (min-width:700px){.scrim{place-items:center}.sheet{border-radius:28px}}
.group{display:flex;flex-wrap:wrap;gap:10px}
.chip{border:1.5px solid var(--ring);border-radius:999px;padding:10px 18px;font-weight:600;font-size:1rem}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.seg{display:flex;background:var(--btn2);border-radius:16px;padding:5px}
.seg button{flex:1;padding:12px;border-radius:12px;font-weight:700;color:var(--muted)}
.seg button[aria-pressed="true"]{background:var(--bg);color:var(--ink)}
.kw{margin:clamp(14px,2.5vh,24px) 0 0;font-size:clamp(1rem,1.9vw,1.25rem);color:var(--muted)}
.handle{font-weight:600;font-size:clamp(.95rem,1.7vw,1.1rem);letter-spacing:.01em}
.stage .pill{display:inline-block;margin-bottom:clamp(14px,2.5vh,24px)}
.btn:disabled{opacity:.35;cursor:default}
.hidden{display:none!important}
</style>
</head>
<body>
<div class="app">
  <div class="top">
    <span class="handle">@dr.suege</span>
    <div>
      <button class="icon" id="fs" aria-label="Tam ekran"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg></button>
      <button class="icon" id="openSettings" aria-label="Ayarlar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg></button>
    </div>
  </div>

  <main class="stage" aria-live="polite">
    <div>
      <span class="pill" id="cat"></span>
      <p class="q" id="q"></p>
      <p class="kw hidden" id="kw"></p>
      <p class="follow hidden" id="follow"></p>
    </div>
    <div class="dial" id="dial">
      <svg viewBox="0 0 100 100"><circle class="bg" cx="50" cy="50" r="45"/><circle class="fg" id="arc" cx="50" cy="50" r="45" stroke-dasharray="282.74" stroke-dashoffset="282.74"/></svg>
      <div class="num" id="num">1:00</div>
    </div>
  </main>

  <div class="controls">
    <button class="btn alt" id="b1">Değiştir</button>
    <button class="btn" id="b2">Başla</button>
  </div>
</div>

<div class="scrim hidden" id="scrim">
  <div class="sheet" role="dialog" aria-label="Ayarlar">
    <div class="seg" id="modes">
      <button data-m="quick">Hazırlıksız</button>
      <button data-m="prep">10 dk hazırlık + 1 dk</button>
    </div>
    <div class="group" id="durations">
      <button class="chip" data-s="30">30 sn</button>
      <button class="chip" data-s="60">60 sn</button>
      <button class="chip" data-s="90">90 sn</button>
    </div>
    <div class="group" id="chips"></div>
    <button class="btn" id="closeSettings">Tamam</button>
  </div>
</div>

